generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Album {
  id          String   @id @default(cuid())
  name        String
  description String?
  coverImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  photos      Photo[]
}

model Photo {
  id          String   @id @default(cuid())
  url         String
  title       String?
  description String?
  width       Int?
  height      Int?
  albumId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  highResUrl     String?
  displayUrl     String?
  dominantColor  String?
  tags           String?
  technicalData  String?
  album       Album?   @relation(fields: [albumId], references: [id])
}

model AdminConfig {
  id        String @id @default("admin")
  username  String @default("admin")
  password  String
  siteTitle String @default("Lunar Gallery")
  aiMode    String @default("local")
  bedrockInputTokens  Int @default(0)
  bedrockOutputTokens Int @default(0)
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  externalUrl String?
  eventDate   DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
